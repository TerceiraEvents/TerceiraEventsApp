{
  "expo": {
    "name": "Terceira Events",
    "slug": "TerceiraEventsApp",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d5016"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.terceiraevents.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:eventosterceira.pt"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2d5016"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.terceiraevents.app",
      "versionCode": 4,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/events" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/events/" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/weekly" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/weekly/" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/special" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/special/" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/pt/events" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/pt/events/" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/pt/weekly" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/pt/weekly/" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/pt/special" },
            { "scheme": "https", "host": "eventosterceira.pt", "path": "/pt/special/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2d5016"
        }
      ],
      "expo-calendar",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayEvents",
              "label": "Terceira Events - Today",
              "description": "Shows today's events on Terceira Island",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-localization",
      "./plugins/withFontScale"
    ],
    "owner": "chrisrackauckas",
    "locales": {
      "pt-PT": "./locales/pt-PT.json",
      "pt-BR": "./locales/pt-BR.json"
    },
    "extra": {
      "eas": {
        "projectId": "fc3bd113-0884-4800-b6f0-7adcf97f0990"
      }
    },
    "scheme": "terceiraevents"
  }
}
